<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/static/css/style.css">
  <link rel="icon" href="/static/manalearn.svg" type="image/svg+xml">
</head>
<body>
  <%- include('nav', { user: user, active: active }) %>

  <main class="page">
    <h1 class="page-title">Grass</h1>
    <p class="page-subtitle">continue the streak, gently.</p>

    <% if (!rateGoals || rateGoals.length === 0) { %>
    <section class="empty-state">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-5 3-8 8-9-1 6-3 9-8 9Z"/><path d="M12 21c0-6-3.5-10-9-11 1 7 4 11 9 11Z"/><path d="M12 21v-6"/></svg>
      <p>There are no goals to display on Grass yet.</p>
<p class="muted">First, create a Goal with a daily time target in <a href="/goals">Goals</a> (for example, Mathematics — 60 min/day).</p>    </section>
    <% } else { %>
    <section class="grass-header">
      <div class="goal-select-wrap">
        <label for="goal-select" class="muted small-label">Goal</label>
        <select id="goal-select">
          <% rateGoals.forEach(function(g) { %>
          <option value="<%= g.id %>" data-target="<%= g.targetValue %>" data-unit="<%= g.targetUnit %>"><%= g.title %></option>
          <% }); %>
        </select>
      </div>
      <div class="year-select-wrap">
        <label for="year-select" class="muted small-label">Year</label>
        <select id="year-select"></select>
      </div>
      <span id="streak-badge" class="streak-badge" hidden>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-5 3-8 8-9-1 6-3 9-8 9Z"/><path d="M12 21c0-6-3.5-10-9-11 1 7 4 11 9 11Z"/></svg>
        <span id="streak-badge-text"></span>
      </span>
    </section>

    <section id="today-entry" class="today-entry">
      <div class="today-entry-top">
        <div>
          <div class="today-entry-label">Today · <span id="today-entry-date"><%= today %></span></div>
          <div class="today-entry-progress">
            <span id="today-entry-actual" class="today-entry-actual">0</span>
            <span class="muted">/ <span id="today-entry-target">0</span> <span id="today-entry-unit">min</span></span>
          </div>
        </div>
        <div class="today-entry-bar" aria-hidden="true"><div id="today-entry-fill" class="today-entry-fill"></div></div>
      </div>
      <div class="today-entry-form">
        <label class="today-entry-input">
          <span class="muted small-label">Add study time</span>
          <input type="number" id="today-minutes" min="1" step="1" inputmode="numeric" placeholder="30">
        </label>
        <div class="today-quick" role="group" aria-label="Quick add">
          <button type="button" class="chip-button" data-add="15">+15</button>
          <button type="button" class="chip-button" data-add="30">+30</button>
          <button type="button" class="chip-button" data-add="60">+60</button>
        </div>
        <button type="button" id="today-add" class="primary-button">Add</button>
      </div>
      <p id="today-entry-hint" class="muted today-entry-hint">You can add entries as many times as you like today. The more you add, the darker today's square will become.</p>
      <p id="today-entry-error" class="form-error" hidden></p>
    </section>

    <section id="grass-container" class="grass-container" aria-live="polite">
      <p class="muted">Loading…</p>
    </section>

    <section class="today-summary">
      <h2 class="section-title">Today · <span id="today-heading-date"><%= today %></span></h2>
      <div id="today-summary-list" class="today-list">
        <p class="muted">Loading…</p>
      </div>
    </section>
    <% } %>
  </main>

  <dialog id="day-dialog" class="day-dialog">
    <form method="dialog" class="day-dialog-form">
      <header class="day-dialog-header">
        <h2 id="day-dialog-date">Date</h2>
        <button type="submit" class="icon-button" aria-label="Close">×</button>
      </header>

      <div id="day-existing-sessions" class="existing-sessions"></div>

      <div class="add-session-form">
        <h3 class="add-session-title">Add a session</h3>
        <div class="form-row">
          <label>Goal
            <select id="session-goal"></select>
          </label>
          <label>Subject
            <input type="text" id="session-subject" placeholder="例: Calculus">
          </label>
        </div>
        <div class="form-row">
          <label>Duration (min)
            <input type="number" id="session-duration" min="0" step="1" placeholder="60">
          </label>
        </div>
        <label class="full-width">Description <span class="muted">(optional)</span>
          <textarea id="session-description" rows="3" placeholder="今日勉強した内容を自由に書いてください"></textarea>
        </label>
        <p id="session-form-error" class="form-error" hidden></p>
        <button type="button" id="session-save" class="primary-button">Save session</button>
      </div>
    </form>
  </dialog>

  <script>
    window.STUDYLOG_USER_ID = "<%= user.id %>";
  </script>
  <script src="/static/js/app.js"></script>
</body>
</html>
