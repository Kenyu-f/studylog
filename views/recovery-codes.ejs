<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · StudyLog</title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body class="auth-body">
  <main class="auth-card auth-card-wide">
    <div class="auth-badge">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
    </div>
    <h1 class="auth-title"><%= heading %></h1>
    <p class="auth-subtitle"><%= subtitle %></p>

    <p class="recovery-warning">このコードは今しか表示されません。パスワードと同じくらい大切に保管してください(メール機能は無いため、これが唯一の再設定手段です)。</p>

    <div class="recovery-list">
      <% items.forEach(function(item) { %>
      <div class="recovery-card">
        <div>
          <div class="recovery-card-label"><%= item.label %></div>
          <div class="recovery-card-code" data-code="<%= item.code %>"><%= item.code %></div>
        </div>
        <button type="button" class="recovery-copy-button" data-copy-target>Copy</button>
      </div>
      <% }); %>
    </div>

    <a href="<%= nextUrl %>" class="primary-button" style="display:block; text-align:center; text-decoration:none; margin-top: 6px;"><%= nextLabel %></a>
  </main>

  <script>
    document.querySelectorAll('[data-copy-target]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var code = btn.previousElementSibling.querySelector('[data-code]').dataset.code;
        navigator.clipboard.writeText(code).then(function () {
          var original = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(function () { btn.textContent = original; }, 1500);
        });
      });
    });
  </script>
</body>
</html>
