<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
  <%- include('nav', { user: user, active: active }) %>

  <main class="page">
    <section class="goals-header">
      <div>
        <h1 class="page-title">Goals</h1>
        <p class="page-subtitle">long-term, held loosely; today, held closely.</p>
      </div>
      <button id="new-goal-button" class="primary-button">+ New goal</button>
    </section>

    <% if (!rows || rows.length === 0) { %>
    <section class="empty-state">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-5 3-8 8-9-1 6-3 9-8 9Z"/><path d="M12 21c0-6-3.5-10-9-11 1 7 4 11 9 11Z"/><path d="M12 21v-6"/></svg>
      <p>まだ Goal がありません。</p>
      <p class="muted">「+ New goal」から最初の目標を作成してください。</p>
    </section>
    <% } %>

    <ul class="goal-tree">
      <% (rows || []).forEach(function(row) { %>
      <% var g = row.node.goal; %>
      <li class="goal-row" style="--depth: <%= row.node.depth %>" data-goal-id="<%= g.id %>">
        <div class="goal-row-main">
          <span class="goal-indent"></span>
          <div class="goal-row-text">
            <span class="goal-title"><%= g.title %></span>
            <span class="goal-meta">
              <span class="tag tag-type-<%= g.type %>"><%= g.type %></span>
              <span class="tag tag-owner"><%= row.ownerTag %></span>
              <% if (g.targetValue > 0) { %>
              <span class="muted"><%= g.targetValue %> <%= g.targetUnit %><% if (g.targetPeriod === 'day') { %>/day<% } else if (g.targetPeriod === 'week') { %>/week<% } else { %> total<% } %></span>
              <% } %>
            </span>
            <% if (g.description) { %><p class="goal-description"><%= g.description %></p><% } %>
          </div>
          <button class="link-button edit-goal-button" data-goal-id="<%= g.id %>">Edit</button>
        </div>
        <% if (row.progress.hasPercent) { %>
        <div class="progress-bar-wrap">
          <div class="progress-bar"><div class="progress-bar-fill" style="width: <%= Math.round((row.progress.actualMin / row.progress.targetMin) * 100) %>%"></div></div>
          <span class="progress-label muted"><%= row.progress.actualMin %> / <%= row.progress.targetMin %> <%= g.targetUnit %></span>
        </div>
        <% } %>
      </li>
      <% }); %>
    </ul>
  </main>

  <dialog id="goal-dialog" class="goal-dialog">
    <form method="dialog" class="goal-dialog-form">
      <header class="day-dialog-header">
        <h2 id="goal-dialog-title">New goal</h2>
        <button type="submit" class="icon-button" aria-label="Close">×</button>
      </header>

      <input type="hidden" id="goal-id">

      <label>Title
        <input type="text" id="goal-title" required>
      </label>
      <label>Description <span class="muted">(optional)</span>
        <textarea id="goal-description" rows="2"></textarea>
      </label>
      <label>Parent goal
        <select id="goal-parent"><option value="">— (top level)</option></select>
      </label>
      <div class="form-row">
        <label>Type
          <select id="goal-type">
            <option value="long-term">long-term</option>
            <option value="medium-term">medium-term</option>
            <option value="short-term" selected>short-term</option>
          </select>
        </label>
        <label>Owner
          <select id="goal-shared">
            <option value="false">Just me</option>
            <option value="true">Shared</option>
          </select>
        </label>
      </div>

      <label>Progress type
        <select id="goal-progress-mode">
          <option value="none">No numeric progress (e.g. abstract goals)</option>
          <option value="rate">Daily target → shows on Grass (e.g. 60 min/day)</option>
          <option value="cumulative">Cumulative total → shows a progress bar (e.g. 3000 min total)</option>
        </select>
      </label>

      <div id="goal-target-fields" class="form-row" hidden>
        <label>Target value (minutes)
          <input type="number" id="goal-target-value" min="0" step="1">
        </label>
        <label id="goal-target-period-wrap">Period
          <select id="goal-target-period">
            <option value="day">per day</option>
            <option value="week">per week</option>
            <option value="total">total (lifetime)</option>
          </select>
        </label>
      </div>

      <p id="goal-form-error" class="form-error" hidden></p>
      <div class="goal-dialog-actions">
        <button type="button" id="goal-delete-button" class="link-button danger" hidden>Delete goal</button>
        <button type="button" id="goal-save-button" class="primary-button">Save goal</button>
      </div>
    </form>
  </dialog>

  <script src="/static/js/goals.js"></script>
</body>
</html>
